generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Animal {
  id                    Int               @id @default(autoincrement())
  nome                  String
  nomesRegionais        String[]
  nomeCientifico        String            @unique
  comportamento         String
  tipoAlimentacao       TipoAlimentacao
  descricaoAlimentacao  String
  statusConservacao     StatusConservacao
  informacoesAdicionais String[]
  imagemUrl             String?
  criadoEm              DateTime          @default(now())
  atualizadoEm          DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Pergunta {
  id       Int        @id @default(autoincrement())
  pergunta String
  fotoUrl  String?
  Resposta Resposta[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Resposta {
  id         Int      @id @default(autoincrement())
  resposta   String
  perguntaId Int
  Pergunta   Pergunta @relation(fields: [perguntaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pergunta")
}

enum StatusConservacao {
  NAO_AVALIADO
  DADOS_INSUFICIENTES
  POUCO_PREOCUPANTE
  QUASE_AMEACADO
  VULNERAVEL
  EM_PERIGO
  CRITICAMENTE_EM_PERIGO
  EXTINTO_NA_NATUREZA
  EXTINTO
}

enum TipoAlimentacao {
  CARNIVORO
  HERBIVORO
  ONIVORO
  FRUGIVORO
  INSETIVORO
  PISCIVORO
  NECTARIVORO
  DETRITIVORO
}
